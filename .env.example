# Supabase credentials used by server-side routes such as keepalive.
# Keep these server-side; do not prefix them with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Public Supabase Storage configuration for browser-delivered website assets.
# Leave these empty/unset to use the existing local /public assets.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="birthday-assets"

# Existing application variables are documented below.
# DATABASE_URL="..."
# DIRECT_URL="..."
