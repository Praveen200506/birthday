# Supabase credentials used by the keep-alive route.
# Keep these server-side; do not prefix them with NEXT_PUBLIC_.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Public base URL for static assets.
# Leave unset to use the existing local /public assets.
# Set this to the real Cloudflare R2 public/custom-domain URL after assets
# have been uploaded and verified manually. Do not use R2 access keys here.
# NEXT_PUBLIC_R2_PUBLIC_URL="https://your-real-r2-public-domain.example"

# Existing application variables are documented below.
# DATABASE_URL="..."
# DIRECT_URL="..."
