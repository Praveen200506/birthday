# ==============================================================================
# Birthday App & Private Journal — Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL - Neon / Supabase / Vercel Postgres / Docker / Local)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/birthday_db?schema=public"

# ------------------------------------------------------------------------------
# 2. BLOG READER LOCK (4-digit PIN)
# Generate with: node scripts/generate-pin-hash.mjs <your-4-digit-pin>
# ------------------------------------------------------------------------------
BLOG_PIN_HASH="4cf09d944e8371307cc2c01824982631a0e7f3c051a8f9eb9be4e3f4efce981c"
BLOG_SESSION_SECRET="generate_a_random_32_character_reader_secret_key"

# ------------------------------------------------------------------------------
# 3. AUTHOR / ADMIN DESK
# Generate with: node scripts/generate-pin-hash.mjs <your-author-password>
# ------------------------------------------------------------------------------
BLOG_ADMIN_PASSWORD_HASH="8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92"
BLOG_ADMIN_SESSION_SECRET="generate_a_random_32_character_admin_secret_key"

# ------------------------------------------------------------------------------
# 4. VISITOR NOTIFICATIONS (Resend - https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefg"
NOTIFICATION_EMAIL="your-email@example.com"
RESEND_FROM="Birthday App <onboarding@resend.dev>"
