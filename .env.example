# Server-only Supabase credentials. Never expose the service-role key to the browser.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="birthday-assets"

# Public Supabase settings used by the website and browser's signed image uploads.
# Set these to the same Supabase project as SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="birthday-assets"

# PostgreSQL / Prisma
# DATABASE_URL="..."
# DIRECT_URL="..."

# In production, configure these for the author portal and memory-upload API.
# BLOG_ADMIN_PASSWORD_HASH="64-character SHA-256 hash from scripts/generate-pin-hash.mjs"
# BLOG_ADMIN_SESSION_SECRET="random secret with at least 32 characters"
# BLOG_PIN_HASH="64-character SHA-256 hash"
# BLOG_SESSION_SECRET="random secret with at least 32 characters"

# Optional visitor email notifications
# RESEND_API_KEY="re_..."
# NOTIFICATION_EMAIL="your-email@example.com"
# RESEND_FROM="Birthday App <onboarding@resend.dev>"
